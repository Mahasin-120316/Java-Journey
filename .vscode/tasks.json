{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Fast Run Java File",
            "type": "shell",
            "command": "javac -d . ${relativeFile} ; java ${relativeFileDirname}.${fileBasenameNoExtension}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
